<%- include('../fragments/header') %><main id="top"><a href="<%= basePath %>/products">← All products</a><article class="product-detail"><img src="<%= basePath %>/assets/images/<%= product.image %>-600.webp" alt="<%= product.name %>"><div><p class="eyebrow"><%= product.type %></p><h1><%= product.name %></h1><p><%= product.description %></p><strong><%= Number(product.price).toFixed(2) %> EUR</strong><dl><dt>Weight</dt><dd><%= product.weight %> g</dd><dt>Calories</dt><dd><%= product.calories %> kcal</dd><dt>Ingredients</dt><dd><%= (product.ingredients || []).join(', ') %></dd><dt>Category</dt><dd><%= product.category %></dd><dt>Sugar-free</dt><dd><%= product.diabetic_friendly ? 'Yes' : 'No' %></dd><dt>Added on</dt><dd><time datetime="<%= new Date(product.created_at).toISOString() %>"><%= new Date(product.created_at).toLocaleDateString('en-GB',{timeZone:'UTC'}) %></time></dd></dl><label><input class="cart-choice" type="checkbox" data-id="<%= product.id %>"> Add to cart</label></div></article></main><%- include('../fragments/footer') %>
