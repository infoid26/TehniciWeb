<%- include('../fragments/header') %>
<main id="top">
  <section class="hero" id="welcome"><div><p class="eyebrow">FRESH FROM THE OVEN</p><h1>A little sweetness,<br>every single day.</h1><p>Handmade cakes, pastries and ice cream. Good ingredients, a little imagination and something special to share.</p><a class="btn btn-primary" href="<%= basePath %>/products">Explore our products →</a></div><img src="<%= basePath %>/assets/images/cake.svg" alt="Chocolate cake"></section>
  <section id="offers"><p class="eyebrow">SOMETHING EXTRA</p><h2>A reason to celebrate</h2><div class="info-grid"><article class="feature-panel"><h3>Weekend treat</h3><p>A selection of pastries for a slow Saturday morning. Discover the regular range and our seasonal specials.</p><a href="<%= basePath %>/products?type=pastry">Browse pastries →</a></article><article class="feature-panel"><h3>A lighter little joy</h3><p>Looking for a sugar-free option? Use the diet filter and check every ingredient on the product page.</p><a href="<%= basePath %>/products">Find your favorite →</a></article></div></section>
  <section id="range"><h2>Pick your kind of sweet</h2><div class="category-links"><a href="<%= basePath %>/products?type=cake">Cakes</a><a href="<%= basePath %>/products?type=pastry">Pastries</a><a href="<%= basePath %>/products?type=icecream">Ice cream</a></div></section>
  <section id="gallery"><h2>Made to make you smile</h2><div class="gallery"><% for (const image of images) { %><figure><picture><source media="(max-width:600px)" srcset="<%= basePath %>/assets/images/<%= image.file %>-300.webp"><img src="<%= basePath %>/assets/images/<%= image.file %>-600.webp" alt="<%= image.caption %>" loading="lazy"></picture><figcaption><%= image.caption %></figcaption></figure><% } %></div></section>
  <section id="announcements"><p class="eyebrow">FROM OUR KITCHEN</p><h2>Fresh notes</h2><ol class="news-list"><% for(const note of announcements) { %><li><time datetime="<%= note.date %>"><%= note.date %></time><h3><%= note.title %></h3><p><%= note.text %></p></li><% } %></ol></section>
  <section class="info-grid"><div id="hours"><h2>Our opening hours</h2><div class="table-scroll"><table><caption>Visit our bakery — demonstration schedule</caption><thead><tr><th scope="col">Day</th><th scope="col">Morning</th><th scope="col">Break</th><th scope="col">Afternoon</th></tr></thead><tbody><% for(const row of hours) { %><tr><th scope="row"><%= row.day %></th><td><%= row.morning %></td><td><%= row.break %></td><td><%= row.afternoon %></td></tr><% } %></tbody></table></div><p><label>Kitchen preparation <progress value="75" max="100">75%</progress></label></p></div><div id="faq"><h2>Good to know</h2><details><summary>How do I collect my order?</summary><p>Select products to keep a list in your browser, then check the opening hours.</p></details><details><summary>Where can I find allergens?</summary><p>Each product page lists its ingredients and dietary information.</p></details><details><summary>Is this a real shop?</summary><p>This is an educational demonstration. No payment is collected and no order is sent.</p></details></div></section>
  <section id="recipes"><h2>A moment in the kitchen</h2><div class="info-grid"><div><video controls playsinline preload="metadata" poster="<%= basePath %>/assets/images/cake.svg"><source src="<%= basePath %>/assets/media/bakery.webm" type="video/webm"><track kind="captions" srclang="en" label="English" src="<%= basePath %>/assets/media/captions.vtt" default></video><p><a href="<%= basePath %>/assets/media/captions.vtt">Read the captions</a></p></div><article class="feature-panel"><h3>Build a dessert bowl</h3><ol><li>Choose fresh fruit.</li><li>Add a spoon of vanilla ice cream.</li><li>Finish with a little chocolate.</li></ol><p>For four portions, the amount of each ingredient is multiplied by four:</p><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><msub><mi>q</mi><mn>4</mn></msub><mo>=</mo><mn>4</mn><mo>×</mo><msub><mi>q</mi><mn>1</mn></msub></math></article></div></section>
  <section id="recipe-collection"><h2>Three little recipes</h2><div class="recipe-tabs" aria-label="Choose a recipe"><a href="<%= basePath %>/recipe/fruit" target="recipe-frame">Fruit bowl</a><a href="<%= basePath %>/recipe/chocolate" target="recipe-frame">Chocolate cup</a><a href="<%= basePath %>/recipe/vanilla" target="recipe-frame">Vanilla sundae</a></div><iframe class="recipe-frame" name="recipe-frame" title="Selected recipe" src="<%= basePath %>/recipe/fruit" loading="lazy" sandbox></iframe></section>
</main><%- include('../fragments/footer') %>
