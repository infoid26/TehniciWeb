<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= recipe.name %> — Sweet Corner</title><link rel="stylesheet" href="<%= basePath %>/assets/css/site.css"></head><body><main class="recipe-preview"><img src="<%= basePath %>/assets/images/<%= recipe.image %>.svg" alt=""><div><p class="eyebrow">MAKE A LITTLE JOY</p><h1><%= recipe.name %></h1><h2>Ingredients</h2><ul><% for(const ingredient of recipe.ingredients) { %><li><%= ingredient %></li><% } %></ul><h2>Method</h2><ol><% for(const step of recipe.steps) { %><li><%= step %></li><% } %></ol></div></main></body></html>
