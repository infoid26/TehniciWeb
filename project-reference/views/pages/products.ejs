<%- include('../fragments/header') %><main id="top"><p class="eyebrow">FIND YOUR FAVORITE</p><h1>Our products</h1><form id="filters"><label>Name<input id="search-name" type="search" placeholder="Search products"></label><label>Maximum price<input id="max-price" type="range" min="0" max="30" value="30"><output id="price-value">30</output></label><label>Category<select id="category"><option value="all">All</option><% for(const category of categories) { %><option value="<%= category %>"><%= category %></option><% } %></select></label><label>Ingredients<input id="ingredients" placeholder="For example: milk"></label><fieldset><legend>Diet</legend><label><input type="radio" name="diet" value="all" checked> All</label><label><input type="radio" name="diet" value="yes"> Sugar-free</label></fieldset><label>Sort<select id="sort"><option value="default">Default</option><option value="asc">Price: low to high</option><option value="desc">Price: high to low</option></select></label><button class="btn btn-primary" type="submit">Filter</button><button id="reset-filters" type="reset">Reset</button></form>
<p id="summary" role="status"></p><div id="product-list" class="products"><% for(const product of products) { %><article class="product-card" data-id="<%= product.id %>" data-name="<%= product.name.toLowerCase() %>" data-price="<%= product.price %>" data-category="<%= product.category %>" data-ingredients="<%= (product.ingredients || []).join(',').toLowerCase() %>" data-diabetic="<%= product.diabetic_friendly %>"><a href="<%= basePath %>/product/<%= product.id %>"><img src="<%= basePath %>/assets/images/<%= product.image %>-300.webp" alt="<%= product.name %>"><h2><%= product.name %></h2></a><p><%= product.description %></p><p><strong><%= Number(product.price).toFixed(2) %> EUR</strong> · <%= product.weight %> g</p><label><input type="checkbox" class="cart-choice" data-id="<%= product.id %>"> Add to cart</label></article><% } %></div><p id="empty-state" hidden>No products found.</p><noscript>Filters and the cart require JavaScript. Product links still work.</noscript></main><%- include('../fragments/footer') %>