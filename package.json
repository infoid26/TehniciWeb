{
  "name": "tehnici-web-infoid26",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "description": "Curs interactiv de Tehnici Web pentru INFO ID 26.",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "setup:project-db": "node scripts/setup_project_db.mjs",
    "check": "node scripts/check.mjs && node scripts/check_html_metadata.mjs",
    "check:browser": "node scripts/check_complete.mjs",
    "build:course": "python scripts/build_course.py",
    "build:editor": "node scripts/build_editor.mjs",
    "build:sql": "node scripts/build_sql.mjs",
    "build:templates": "node scripts/build_templates.mjs",
    "build:project": "node scripts/build_project_assets.mjs",
    "check:learning": "node scripts/check_learning.mjs",
    "check:curriculum": "node scripts/check_curriculum.mjs",
    "check:browser-labs": "node scripts/check_browser_labs.mjs",
    "check:server": "node scripts/check_server.mjs",
    "check:azure": "node scripts/check_azure.mjs",
    "check:accounts": "node scripts/check_accounts.mjs && node scripts/check_exam_history.mjs",
    "check:evaluator": "node scripts/check_evaluator.mjs",
    "check:coverage": "node scripts/check_coverage.mjs",
    "check:sandboxes": "node scripts/check_sandboxes.mjs",
    "check:project": "node scripts/check_project.mjs",
    "build:project-video": "node scripts/build_project_video.mjs",
    "check:project:browser": "node scripts/check_project_browser.mjs",
    "check:workshop": "node scripts/check_workshop.mjs",
    "check:progression": "node scripts/check_progression.mjs",
    "check:exam": "node scripts/check_exam_tickets.mjs && node scripts/check_exam_cli.mjs",
    "check:exam:browser": "node scripts/check_exam.mjs",
    "check:reasoning": "node scripts/check_reasoning.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ejs": "^3.1.10",
    "pg": "^8.16.3",
    "sass": "^1.93.2",
    "sharp": "^0.34.4",
    "bootstrap": "^5.3.8",
    "@electric-sql/pglite": "latest",
    "codemirror": "^6.0.2",
    "@codemirror/lang-html": "latest",
    "@codemirror/lang-css": "latest",
    "@codemirror/lang-javascript": "latest",
    "@codemirror/lang-json": "latest",
    "@codemirror/legacy-modes": "latest",
    "esbuild": "^0.28.2",
    "acorn": "^8.15.0",
    "@codemirror/view": "latest",
    "@codemirror/state": "latest",
    "@codemirror/commands": "latest",
    "@codemirror/language": "latest",
    "@lezer/highlight": "latest"
  }
