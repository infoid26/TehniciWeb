<%- include('../fragments/header') %>
<main id="top">
  <p class="eyebrow">FIND YOUR FAVORITE</p><h1>Our products</h1>
  <div class="category-links" aria-label="Product types"><% for(const [type,label] of [['all','All products'],['cake','Cakes'],['pastry','Pastries'],['icecream','Ice cream']]) { %><a href="<%= basePath %>/products?type=<%= type %>" <%- selectedType===type?'aria-current="page"':'' %>><%= label %></a><% } %></div>
  <form id="filters">
    <label>Name starts with<input id="search-name" type="search" placeholder="For example: Chocolate"></label>
    <label>Minimum price<input id="min-price" type="range" min="0" max="70" value="0"><output id="min-price-value">0</output></label>
    <label>Maximum price<input id="max-price" type="range" min="0" max="70" value="70"><output id="price-value">70</output></label>
    <label>Category<select id="category"><option value="all">All</option><% for(const category of categories) { %><option value="<%= category %>"><%= category %></option><% } %></select></label>
    <label>Ingredients<input id="ingredients" placeholder="For example: milk"></label>
    <fieldset><legend>Calories per portion</legend><label><input type="radio" name="calories" value="all" checked> All</label><label><input type="radio" name="calories" value="0:350"> Under 350</label><label><input type="radio" name="calories" value="350:700"> 350–699</label><label><input type="radio" name="calories" value="700:Infinity"> 700 or more</label></fieldset>
    <fieldset><legend>Diet</legend><label><input type="radio" name="diet" value="all" checked> All</label><label><input type="radio" name="diet" value="yes"> Sugar-free</label></fieldset>
    <label>Sort by price, then name<select id="sort"><option value="default">Default</option><option value="asc">Ascending</option><option value="desc">Descending</option></select></label>
    <div class="filter-actions"><button class="btn btn-primary" type="submit">Filter</button><button id="reset-filters" type="reset">Reset</button><button id="calculate-total" type="button">Calculate visible total</button></div>
  </form>
  <p id="summary" role="status"></p><p>Press <kbd>Alt</kbd> + <kbd>C</kbd> to show the total price for two seconds.</p><p id="total-notice" class="total-notice" role="status" hidden></p>
  <div id="product-list" class="products"><% for(const product of products) { %>
    <article class="product-card" data-id="<%= product.id %>" data-name="<%= product.name.toLowerCase() %>" data-price="<%= product.price %>" data-calories="<%= product.calories %>" data-category="<%= product.category %>" data-ingredients="<%= (product.ingredients || []).join(',').toLowerCase() %>" data-diabetic="<%= product.diabetic_friendly %>">
      <a href="<%= basePath %>/product/<%= product.id %>"><img src="<%= basePath %>/assets/images/<%= product.image %>-300.webp" alt="<%= product.name %>"><h2><%= product.name %></h2></a>
      <p><%= product.description %></p><p><strong><%= Number(product.price).toFixed(2) %> EUR</strong> · <%= product.weight %> g · <%= product.calories %> kcal</p><p class="product-category"><%= product.category %></p>
      <label><input type="checkbox" class="cart-choice" data-id="<%= product.id %>"> Add to cart</label>
    </article><% } %>
  </div><p id="empty-state" hidden>No products found. Try resetting the filters.</p><noscript>Filters and the cart require JavaScript. Product links still work.</noscript>
</main><%- include('../fragments/footer') %>
